<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.FlyingSparrow.YiSmartCloud.serve.mapper.MemberServiceOrderMapper">

    <resultMap id="MemberServiceOrderResult" type="org.FlyingSparrow.YiSmartCloud.serve.domain.MemberServiceOrder">
        <id property="id" column="id"/>
        <result property="orderNo" column="order_no"/>
        <result property="familyMemberId" column="family_member_id"/>
        <result property="elderId" column="elder_id"/>
        <result property="projectId" column="project_id"/>
        <result property="count" column="count"/>
        <result property="unitPrice" column="unit_price"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="expectedServiceTime" column="expected_service_time"/>
        <result property="status" column="status"/>
        <result property="payStatus" column="pay_status"/>
        <result property="billId" column="bill_id"/>
        <result property="cancelReason" column="cancel_reason"/>
        <result property="refundReason" column="refund_reason"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="createBy" column="create_by"/>
        <result property="updateBy" column="update_by"/>
        <result property="remark" column="remark"/>
        <result property="statusName" column="status_name"/>
    </resultMap>

    <sql id="selectMemberOrderColumns">
        SELECT id, order_no, family_member_id, elder_id, project_id, count, unit_price, total_amount, expected_service_time,
               status, pay_status, bill_id, cancel_reason, refund_reason, is_deleted, create_time, update_time,
               create_by, update_by, remark,
               CASE status
                   WHEN 0 THEN '待支付'
                   WHEN 1 THEN '待履约'
                   WHEN 2 THEN '已取消'
                   WHEN 3 THEN '已退款'
                   WHEN 4 THEN '已完成'
                   ELSE '未知'
                   END AS status_name
        FROM member_service_order
    </sql>

    <select id="selectMemberOrderList" resultMap="MemberServiceOrderResult">
        <include refid="selectMemberOrderColumns"/>
        WHERE family_member_id = #{memberId}
          AND (is_deleted IS NULL OR is_deleted = 0)
        ORDER BY create_time DESC
    </select>

    <select id="selectMemberOrderById" resultMap="MemberServiceOrderResult">
        <include refid="selectMemberOrderColumns"/>
        WHERE id = #{id}
          AND family_member_id = #{memberId}
          AND (is_deleted IS NULL OR is_deleted = 0)
        LIMIT 1
    </select>

    <select id="selectByBillId" resultMap="MemberServiceOrderResult">
        <include refid="selectMemberOrderColumns"/>
        WHERE bill_id = #{billId}
          AND family_member_id = #{memberId}
          AND (is_deleted IS NULL OR is_deleted = 0)
        LIMIT 1
    </select>

    <update id="softDeleteOrder">
        UPDATE member_service_order
        SET is_deleted = 1,
            update_time = NOW()
        WHERE id = #{id}
          AND family_member_id = #{memberId}
          AND (is_deleted IS NULL OR is_deleted = 0)
    </update>
</mapper>
