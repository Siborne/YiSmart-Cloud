**/miniprogram_npm/

# 小程序 source map（体积与源码映射；若工具链生成可忽略）
mp-weixin/**/*.map

# uni-app 发行/编译输出目录（源码在仓库内且发行到 mp-weixin 时常见）
unpackage/

# HBuilderX 本地工程状态
.hbuilderx/

# 微信云函数依赖（云函数目录内 node_modules）
**/cloudfunctions/**/node_modules/

